<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>STJ Media — Admin Login</title>

<style>
body{
    margin:0;
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    background:#0b0b0b;
    color:white;
    font-family:Arial,sans-serif;
}

.login-box{
    width:90%;
    max-width:400px;
    padding:35px;
    background:#151515;
    border:1px solid #292929;
    border-radius:20px;
    box-sizing:border-box;
}

.logo{
    text-align:center;
    font-size:30px;
    font-weight:bold;
    margin-bottom:8px;
}

.sub{
    text-align:center;
    color:#999;
    margin-bottom:30px;
}

input{
    width:100%;
    box-sizing:border-box;
    padding:15px;
    margin-bottom:15px;
    border-radius:10px;
    border:1px solid #333;
    background:#0d0d0d;
    color:white;
    font-size:15px;
}

button{
    width:100%;
    padding:15px;
    border:0;
    border-radius:10px;
    background:white;
    color:#000;
    font-weight:bold;
    cursor:pointer;
    font-size:15px;
}

#error{
    color:#ff6b6b;
    text-align:center;
    margin-top:15px;
    font-size:14px;
}
</style>
</head>

<body>

<div class="login-box">

    <div class="logo">STJ MEDIA</div>
    <div class="sub">Social Trend Junction · Admin</div>

    <input id="email" type="email" placeholder="Admin email">
    <input id="password" type="password" placeholder="Password">

    <button onclick="login()">Login to Admin</button>

    <div id="error"></div>

</div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<script>

const SUPABASE_URL = "https://acuszwigwpfrumkhtdeh.supabase.co";

const SUPABASE_KEY = "sb_publishable_nXq7buM0ASGpEvRq_12VDQ_yLUkGIo2";

const supabaseClient =
    supabase.createClient(SUPABASE_URL, SUPABASE_KEY);


async function login(){

    const email =
        document.getElementById("email").value.trim();

    const password =
        document.getElementById("password").value;

    const error =
        document.getElementById("error");

    error.innerText = "";

    if(!email || !password){
        error.innerText = "Email aur password enter karo.";
        return;
    }

    const { data, error: loginError } =
        await supabaseClient.auth.signInWithPassword({
            email: email,
            password: password
        });

    if(loginError){

        error.innerText = loginError.message;
        return;

    }

    window.location.href = "dashboard.html";
}

</script>

</body>
</html>
